{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_EMAIL",
    "ADMIN_IP",
    "ADMIN_SECRET",
    "ANTHROPIC_API_KEY",
    "CHATWOOT_ACCOUNT_ID",
    "CHATWOOT_API_KEY",
    "CHATWOOT_URL",
    "CRON_SECRET",
    "DOCUSEAL_API_KEY",
    "DOCUSEAL_TEMPLATE_ID",
    "DOCUSEAL_URL",
    "DOCUSEAL_WEBHOOK_SECRET",
    "EVAL_REGISTRY_WRITE_TOKEN",
    "FIRECRAWL_API_KEY",
    "GROQ_API_KEY",
    "INTEGRATION_ENCRYPTION_KEY",
    "LISTMONK_PASSWORD",
    "LISTMONK_URL",
    "LISTMONK_USERNAME",
    "LISTMONK_WEBHOOK_SECRET",
    "MONTAGE_API_KEY",
    "MONTAGE_URL",
    "MONTAGE_WEBHOOK_SECRET",
    "MUAPI_API_KEY",
    "MUAPI_URL",
    "MUAPI_WEBHOOK_SECRET",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OUTCOME_WEBHOOK_SECRET",
    "PADDLE_API_KEY",
    "PADDLE_ENV",
    "PADDLE_NOTIFICATION_WEBHOOK_SECRET",
    "PADDLE_PRICES",
    "PB_ADMIN_EMAIL",
    "PB_ADMIN_PASSWORD",
    "PLAUSIBLE_API_KEY",
    "PLAUSIBLE_API_URL",
    "PLAUSIBLE_SITE_ID",
    "POSTIZ_API_KEY",
    "POSTIZ_URL",
    "PUBLISH_ENABLED",
    "PUSH_ADMIN_SECRET",
    "QDRANT_API_KEY",
    "QDRANT_URL",
    "RESEND_API_KEY",
    "STAFFD_NOTIFICATION_FROM",
    "TWENTY_API_KEY",
    "TWENTY_API_URL",
    "TWENTY_WEBHOOK_SECRET",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "VERCEL_URL",
    "VOYAGE_API_KEY",
    "WORKER_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
